def play_word_scramble():
‎Custom word bank with tailored clues
‎    word_bank = [
‎        {"word": "eclipse", "hint": "When one celestial body blocks the light of another."},
‎        {"word": "compass", "hint": "An instrument used for navigation and orientation."},
‎        {"word": "lantern", "hint": "A portable light source with a protective enclosure."},
